VITE_MICROSOFT_CLIENT_ID=

# Microsoft sign-in audience. Must match your Entra app registration.
# - common        → All account types (work/school + personal). Requires Entra "Multitenant + personal".
# - consumers     → Personal Microsoft accounts only. Use if Entra is "Personal Microsoft accounts only".
# - organizations → Work/school accounts only
# - {tenant-id}   → Single-tenant app
# Use "common" so both work/school (@company.com) and personal (@outlook.com) accounts can sign in.
VITE_MICROSOFT_AUTHORITY=common

# Optional. Defaults to window.location.origin at runtime.
# Set this only if you need a fixed redirect URI (e.g. custom production domain).
# Must exactly match a SPA redirect URI in Microsoft Entra — no trailing slash.
# VITE_MICROSOFT_REDIRECT_URI=https://your-app.vercel.app
